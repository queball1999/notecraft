/apps/notecraft-web/pkg/
/apps/notecraft-web/dist/

# Test and benchmark output
/testdata/out/
*.profraw
*.profdata
/criterion/

# Local app data created by dev runs
/.notecraft-dev/
*.notecraft-lock

